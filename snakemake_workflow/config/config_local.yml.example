# Machine-local configuration overrides for GFM.
#
# Copy this file to config_local.yml (git-ignored) and fill in the values
# for your machine.  Only include the keys you need to override — everything
# else is inherited from config.yml.
#
# The Snakefile loads this file automatically if it exists:
#   snakemake_workflow/config/config_local.yml
#
# Usage:
#   cp snakemake_workflow/config/config_local.yml.example \
#      snakemake_workflow/config/config_local.yml
#   # then edit config_local.yml

paths:
  # Root directory for all project data and model outputs (D:/GFM on the
  # primary machine).  Every path in config.yml that contains {root} resolves
  # to this value.
  root: "E:/Projects/GFM"         # ← change to your local path

  # Root of the repository clone.
  code_root: "C:/Users/YourName/GFM"   # ← change to your local path

  # Root of the Aqueduct build tree (where aqueduct.exe lives). Only set this
  # if the Aqueduct build lives somewhere other than code_root on this
  # machine (e.g. a separate build directory or drive) - it defaults to
  # code_root if omitted.
  # aqueduct_root: "D:/AqueductBuild"   # ← uncomment and change if needed

# Override tile_grid if the study area is configured differently per machine:
# tile_grid:
#   path: "{root}/inputs/mask/domain_tiles_Mozambique.gpkg"
