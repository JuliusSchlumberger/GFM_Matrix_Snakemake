# Machine-local configuration overrides for GFM.
#
# Copy to config_local.yml (git-ignored) in this directory; only include keys to override.
# Loaded automatically by Snakemake and every script (src/config_utils.load_config).
# On an HPC cluster also copy config_hpc.example.yml to config_hpc.yml.

paths:
  # Every {root} path in config.yml resolves to this.
  root: "/path/to/data_root"                            # <- your data root (<data_root>)

  code_root: "C:/path/to/GFM_Matrix_Snakemake"          # <- your checkout

  # Optional: local SFINCS executable for tests/sfincs_synthetic_end_to_end/test_sfincs_smoke.py
  # (the test skips when unset).
  # sfincs_exe: "C:/path/to/SFINCS/sfincs.exe"
