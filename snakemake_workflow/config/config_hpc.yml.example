# HPC (Linux) path overrides for the GFM HPC job generators.
#
# Copy this file to config_hpc.yml and fill in the values for your cluster. Loaded only by the
# HPC job generators (config_utils.load_config(..., extra_override="config_hpc.yml")), so the
# Windows preprocessing machine can resolve paths both locally and as the compute nodes see them.
# Only include keys to override; the rest comes from config.yml (+ config_local.yml).
#
# Usage:
#   cp snakemake_workflow/config/config_hpc.yml.example \
#      snakemake_workflow/config/config_hpc.yml
#   # then edit config_hpc.yml

paths:
  # Linux mount of the same shared storage as the local paths.root. If it is an autofs mount,
  # `ls`/`cd` into this exact path to confirm it mounts (it may not show in an `ls` of the parent).
  root: "/mnt/gfm"                     # ← change to your HPC's mount path

  # Linux repo checkout; overrides the local machine's code_root.
  # MUST be absolute, not `~`-based: it is embedded as `cd "{code_root}"` in every generated
  # sbatch script, where bash does not expand `~`, so every job would fail.
  code_root: "/mnt/gfm_code"           # ← change to your HPC's repo checkout path (absolute, no `~`)
